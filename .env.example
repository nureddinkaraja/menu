# Copy to .env (or set these in your host's dashboard). Never commit real secrets.
PORT=3000
NODE_ENV=production
# Permanent public address of the menu: what the QR code points to (can also be set in the dashboard)
PUBLIC_URL=https://menu.your-domain.af/
# Where the database, uploaded photos and automatic safety backups live. MUST be on persistent storage.
DATA_DIR=./data
# Set to 1 when running behind nginx/Caddy/a PaaS router (needed for correct client IPs + https)
TRUST_PROXY=1
# Set to false to skip creating the demo menu on first start
SEED_DEMO=true
