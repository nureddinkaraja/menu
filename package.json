{
  "name": "afghan-qr-menu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QR-code restaurant menu (Dari/RTL) with a protected owner dashboard",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build && VITE_EXPORT=1 vite build",
    "start": "node server/index.js",
    "set-owner": "node server/cli/set-owner.js",
    "seed": "node server/cli/seed.js",
    "export": "node server/cli/export-html.js",
    "qr": "node server/cli/make-qr.js",
    "art": "node scripts/make-seed-art.mjs",
    "test": "node --test tests/api.test.js"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "lucide-react": "^1.71.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "vazirmatn": "^33.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.7"
  }
}